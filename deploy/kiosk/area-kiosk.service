[Unit]
Description=Area Overview kiosk (cage + Chromium on a dedicated VT)
Documentation=https://github.com/ekstremedia/area-overview
# pi5ai already has a graphical session on tty1: lightdm autologin as `pi`,
# running rpi-connectd/wayvnc (Terje's remote screen access to this Pi for
# other work). This unit deliberately does NOT touch that session -- it
# takes over a *different*, currently-free VT instead. tty2 is a guess made
# without shell access to the Pi; confirm it is actually free before
# enabling (see deploy/kiosk/README.md) and change TTYPath/Conflicts below
# together if it isn't.
After=network-online.target
Wants=network-online.target
Conflicts=getty@tty2.service

[Service]
# Standard pattern for running a single-app Wayland compositor (cage) as a
# systemd system service bound to one VT under logind, coexisting with an
# unrelated graphical session on another VT -- see cage's own wiki,
# "Starting cage on a tty with systemd". `PAMName=login` opens a logind
# session for `kiosk` (this is what hands cage its `XDG_RUNTIME_DIR` and
# seat access); `TTYPath` + the `TTY*` knobs give it exclusive use of the
# VT instead of sharing whatever `$XDG_VTNR` a login shell would pick.
Type=simple
User=kiosk
Group=kiosk
PAMName=login
TTYPath=/dev/tty2
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty2
UtmpMode=user
ExecStart=/usr/bin/cage -- /usr/local/bin/start-kiosk.sh
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
