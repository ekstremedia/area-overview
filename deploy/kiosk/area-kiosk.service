[Unit]
Description=Area Overview kiosk (cage + Chromium on a dedicated VT)
Documentation=https://github.com/ekstremedia/area-overview
# pi5ai has a graphical session (lightdm + labwc) on VT7, with lightdm
# autologin as `pi` and a getty on tty1 (idle). This unit deliberately does
# NOT touch that session -- it takes over a *different*, dedicated VT
# instead. VT8 is chosen because logind's default NAutoVTs=6 means it will
# never auto-spawn a getty on tty8, and it's above the lightdm VT7, so
# logind will never steal this service via the Conflicts mechanism if
# someone hits Ctrl+Alt+F2. This ensures the kiosk survives unattended
# without accidental user input on the keyboard.
After=network-online.target
Wants=network-online.target
Conflicts=getty@tty8.service

[Service]
# Standard pattern for running a single-app Wayland compositor (cage) as a
# systemd system service bound to one VT under logind, coexisting with an
# unrelated graphical session on another VT -- see cage's own wiki,
# "Starting cage on a tty with systemd". `PAMName=login` opens a logind
# session for `kiosk` (this is what hands cage its `XDG_RUNTIME_DIR` and
# seat access); `TTYPath` + the `TTY*` knobs give it exclusive use of the
# VT instead of sharing whatever `$XDG_VTNR` a login shell would pick.
Type=simple
User=kiosk
Group=kiosk
PAMName=login
TTYPath=/dev/tty8
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty8
UtmpMode=user
ExecStart=/usr/bin/cage -- /usr/local/bin/start-kiosk.sh
# Force the kiosk to become the active/foreground session on boot.
# logind only grants DRM master + input-device ACLs to the active session on
# the seat; without this, cage starts successfully but the panel stays on the
# inactive pi desktop (tty7) because lightdm's minimum-vt=7 makes it foreground
# by default. The `+` prefix runs chvt as root regardless of User=kiosk, which
# is necessary since chvt needs CAP_SYS_TTY_CONFIG.
ExecStartPost=+/usr/bin/chvt 8
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
