{
    "name": "area-overview",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Reactive vanilla-TypeScript live map and weather/aurora/tide/camera overview, with a Fastify BFF in front of nesthus.no.",
    "scripts": {
        "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
        "dev:server": "tsx watch src/server/index.ts",
        "dev:web": "vite",
        "build": "npm run build:web && npm run build:server",
        "build:web": "vite build",
        "build:server": "tsc -p tsconfig.server.json",
        "start": "tsx src/server/index.ts",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
        "prepare": "simple-git-hooks"
    },
    "lint-staged": {
        "*.ts": [
            "prettier --write",
            "eslint --fix"
        ]
    },
    "simple-git-hooks": {
        "pre-commit": "npx lint-staged"
    },
    "license": "MIT",
    "author": "Terje Nesthus",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/leaflet": "^1.9.22",
        "@types/node": "^26.4.1",
        "concurrently": "^10.0.5",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "happy-dom": "^20.14.0",
        "lint-staged": "^17.4.1",
        "prettier": "^3.9.6",
        "simple-git-hooks": "^2.14.0",
        "tsx": "^4.23.13",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.69.0",
        "vite": "^8.2.2",
        "vitest": "^5.0.0",
        "yaml": "^2.9.0"
    },
    "dependencies": {
        "@fastify/compress": "^9.2.0",
        "@fastify/static": "^10.1.3",
        "@fontsource-variable/source-serif-4": "^5.3.0",
        "fastify": "^5.12.3",
        "leaflet": "^1.9.4",
        "simple-keyboard": "^3.8.183",
        "simple-keyboard-layouts": "^3.4.256",
        "zod": "^4.5.4"
    }
}
