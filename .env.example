PORT=8141
HOST=127.0.0.1
UPSTREAM_BASE_URL=https://nesthus.no
UPSTREAM_TIMEOUT_MS=8000
CACHE_TTL_MS=30000
SETTINGS_FILE=./data/settings.json
# A passphrase you can type on a touchscreen, at least 16 characters;
# four random words is good.
SETTINGS_PASSWORD=
BARENTSWATCH_CLIENT_ID=
BARENTSWATCH_CLIENT_SECRET=
ADSB_PROVIDER=adsblol
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Per-bbox cache TTL for /api/ships and /api/aircraft; keep >= 10000 in
# production, to stay inside the providers' fair-use expectations. Left at
# their defaults unless you have a specific reason to change them.
SHIPS_CACHE_TTL_MS=10000
AIRCRAFT_CACHE_TTL_MS=10000
# Minimum spacing between nationwide BarentsWatch AIS fetches. The whole
# country arrives in one download that every viewport is then filtered out
# of, so this -- not SHIPS_CACHE_TTL_MS -- is what bounds upstream load,
# and it does so no matter how many people have the map open.
SHIPS_SNAPSHOT_REFRESH_MS=10000
# The longest this app will present AIS positions it fetched earlier as
# current traffic while BarentsWatch is unreachable. Past this, /api/ships
# falls through to its own stale cache and then to remembered vessels.
SHIPS_SNAPSHOT_MAX_STALE_MS=600000
# How often this process may call the ADS-B provider, across every viewport
# at once: one request per ADSB_MIN_INTERVAL_MS on average, with up to
# ADSB_BURST banked for the flurry of map moves a real pan produces. The
# aggregators are free, keyless community services that see one caller --
# this app -- however many people have the map open, so raising the
# interval is the polite direction.
ADSB_MIN_INTERVAL_MS=2000
ADSB_BURST=4
# Per-bbox cache TTLs for /api/road-situations and /api/road-cameras.
# Road notices can change at any moment; the camera roster is a fixed set
# of installations that barely moves, so it is held two and a half times
# as long.
ROAD_SITUATIONS_CACHE_TTL_MS=120000
ROAD_CAMERAS_CACHE_TTL_MS=300000
# How often this process may call Statens vegvesen's OGC GeoServer, across
# both road routes and every viewport at once: one request per
# VEGVESEN_MIN_INTERVAL_MS on average, with up to VEGVESEN_BURST banked for
# the map moves a real pan produces. The service is keyless and free, with
# no quota to push back with, so raising the interval is the polite
# direction.
VEGVESEN_MIN_INTERVAL_MS=500
VEGVESEN_BURST=6
# How long a point forecast (/api/weather?lat&lng, /api/tide?lat&lng) is
# held. Much longer than CACHE_TTL_MS: the home position is a live display,
# but a visitor's point forecast does not change by the half-minute and
# every distinct coordinate is its own upstream call.
POINT_FORECAST_TTL_MS=600000
# CARTO account API key for the map's dark-theme basemap tiles. Optional --
# left empty, the dark theme's tiles still load, just watermarked
# "API key required" by CARTO. Exposed to the frontend as-is via
# GET /api/map-config (it is a public, client-visible key, not a secret).
CARTO_API_KEY=
# Identifies this app to Entur's realtime API via the ET-Client-Name header
# -- Entur's own convention in place of a credential; the feed is otherwise
# keyless.
ENTUR_CLIENT_NAME=nesthus-area-overview
# Per-bbox cache TTL for /api/transit.
TRANSIT_CACHE_TTL_MS=10000
# How often this process may call Entur's realtime vehicles API, across
# every viewport at once: one request per ENTUR_MIN_INTERVAL_MS on average,
# with up to ENTUR_BURST banked for the map moves a real pan produces. The
# API is keyless and free, with no quota to push back with, so raising the
# interval is the polite direction.
ENTUR_MIN_INTERVAL_MS=5000
ENTUR_BURST=3
# Cache TTL for /api/warnings' MET Alerts half, keyed per-bbox. Warnings
# change far slower than a position fix.
MET_ALERTS_CACHE_TTL_MS=300000
# MET Norway's API terms of use require every caller to identify itself with
# a descriptive User-Agent including contact information. Not a secret.
MET_USER_AGENT=area-overview-bff/0.1 (+https://area.nesthus.no; terjen@gmail.com)
# How often this process may call MET Alerts, across every viewport at once:
# one request per MET_MIN_INTERVAL_MS on average, with up to MET_BURST
# banked for the map moves a real pan produces. Keyless and free, with no
# quota to push back with, so raising the interval is the polite direction.
# One call fetches the whole of Norway, hence the longer interval than the
# other keyless-upstream gates.
MET_MIN_INTERVAL_MS=20000
MET_BURST=2
# Cache TTL for /api/warnings' NVE Varsom avalanche half -- a region's danger
# level, which NVE itself updates at most a few times a day.
AVALANCHE_CACHE_TTL_MS=1800000
# NVE Varsom's forecast region roster -- geometry that essentially never
# changes, cached far longer than the danger levels themselves.
AVALANCHE_REGIONS_CACHE_TTL_MS=86400000
# How often this process may call NVE Varsom, across the region roster fetch
# and every per-region warning fetch at once: one request per
# NVE_MIN_INTERVAL_MS on average, with up to NVE_BURST banked for a viewport
# that touches several regions at once.
NVE_MIN_INTERVAL_MS=60000
NVE_BURST=2
# Cache TTL for /api/species, keyed per-bbox and per settings.species.days
# window. GBIF's occurrence index is itself a slow-moving snapshot.
SPECIES_CACHE_TTL_MS=1800000
