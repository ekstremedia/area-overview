PORT=8141
HOST=127.0.0.1
UPSTREAM_BASE_URL=https://nesthus.no
UPSTREAM_TIMEOUT_MS=8000
CACHE_TTL_MS=30000
SETTINGS_FILE=./data/settings.json
# A passphrase you can type on a touchscreen, at least 16 characters;
# four random words is good.
SETTINGS_PASSWORD=
BARENTSWATCH_CLIENT_ID=
BARENTSWATCH_CLIENT_SECRET=
ADSB_PROVIDER=adsblol
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Per-bbox cache TTL for /api/ships and /api/aircraft; keep >= 10000 in
# production (see the plan). Left at their defaults unless you have a
# specific reason to change them.
SHIPS_CACHE_TTL_MS=10000
AIRCRAFT_CACHE_TTL_MS=10000
# Minimum spacing between nationwide BarentsWatch AIS fetches. The whole
# country arrives in one download that every viewport is then filtered out
# of, so this -- not SHIPS_CACHE_TTL_MS -- is what bounds upstream load,
# and it does so no matter how many people have the map open.
SHIPS_SNAPSHOT_REFRESH_MS=10000
# The longest this app will present AIS positions it fetched earlier as
# current traffic while BarentsWatch is unreachable. Past this, /api/ships
# falls through to its own stale cache and then to remembered vessels.
SHIPS_SNAPSHOT_MAX_STALE_MS=600000
# How often this process may call the ADS-B provider, across every viewport
# at once: one request per ADSB_MIN_INTERVAL_MS on average, with up to
# ADSB_BURST banked for the flurry of map moves a real pan produces. The
# aggregators are free, keyless community services that see one caller --
# this app -- however many people have the map open, so raising the
# interval is the polite direction.
ADSB_MIN_INTERVAL_MS=2000
ADSB_BURST=4
# CARTO account API key for the map's dark-theme basemap tiles. Optional --
# left empty, the dark theme's tiles still load, just watermarked
# "API key required" by CARTO. Exposed to the frontend as-is via
# GET /api/map-config (it is a public, client-visible key, not a secret).
CARTO_API_KEY=
